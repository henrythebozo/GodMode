# ---- GodMode Call configuration -------------------------------------------
# Copy this file to `.env` and fill it in. Never commit your real .env.
# These values stay on the SERVER and are never sent to the browser.

# --- ElevenLabs (voice) — REQUIRED -----------------------------------------
# Create an API key:  https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Agent's ID, from the Agents dashboard:  https://elevenlabs.io/app/agents
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: default voice to override the agent's voice with (a voice_id).
# Leave blank to use the agent's configured voice. The user can also pick one
# in-app from your account's voices.
ELEVENLABS_VOICE_ID=

# --- Vision (sees camera snapshots) — REQUIRED for visual questions --------
# 'anthropic' (default) or 'openai'
VISION_PROVIDER=anthropic
# Anthropic key covers BOTH vision and the optional price web-search.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Model to use for vision. Set to a model your account can access.
# Anthropic examples: claude-sonnet-5-5 (default), claude-haiku-5-5 (cheaper).
# OpenAI example: gpt-4o
VISION_MODEL=claude-sonnet-5-5
# Only needed if VISION_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# --- Current-info / price lookup (web search) — OPTIONAL, PAID -------------
# When true, "how much is this worth?" can trigger a live web search via
# Claude's web_search tool. This is billed per search by Anthropic in addition
# to tokens. Off by default. Requires ANTHROPIC_API_KEY above.
PRICE_CHECK_ENABLED=false
SEARCH_MODEL=claude-sonnet-5-5
# SEARCH_TOOL_TYPE=web_search_20250305
# SEARCH_MAX_USES=5

# --- Scene-awareness (optional, low-frequency ongoing frames) --------------
# How often (ms) frames are sent when the user turns on "scene awareness".
# This is OFF by default in the UI and clearly indicated when on. Each frame
# is a billable vision call, so keep the interval high.
SCENE_AWARENESS_INTERVAL_MS=20000

# --- Server ----------------------------------------------------------------
PORT=8787
MAX_UPLOAD=8mb
# For HTTPS (needed for camera/mic on real phones). Point at a cert+key.
# SSL_CERT=./certs/cert.pem
# SSL_KEY=./certs/key.pem
