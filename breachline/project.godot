[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="player_blockers"
3d_physics/layer_4="projectiles"
3d_physics/layer_5="triggers"
3d_physics/layer_6="pickups"
3d_physics/layer_7="hurtboxes"

[physics]

common/physics_ticks_per_second=64
3d/default_gravity=15.0

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
occlusion_culling/use_occlusion_culling=true
